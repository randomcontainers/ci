    {
      "name": "yt-dlp",
      "kind": "package",
      "title": "yt-dlp",
      "summary": "Downloads video and audio from YouTube and many other sites.",
      "homepage": "https://github.com/yt-dlp/yt-dlp",
      "repository": "https://github.com/randomcontainers/yt-dlp",
      "license": "Unlicense AND MIT AND MIT-0 AND ISC AND BSD-2-Clause AND BSD-3-Clause AND Apache-2.0 AND MPL-2.0 AND GPL-2.0-or-later AND curl AND Zlib AND Unicode-DFS-2016",
      "version": "2026.08.19",
      "versioning": "calver",
      "examples": [
        {
          "title": "Download a video into the current directory",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/yt-dlp \"https://www.youtube.com/watch?v=<id>\""
        },
        {
          "title": "List the available formats",
          "command": "docker run --rm ghcr.io/randomcontainers/yt-dlp -F \"https://www.youtube.com/watch?v=<id>\""
        },
        {
          "title": "Extract the audio as MP3",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/yt-dlp -x --audio-format mp3 \"https://www.youtube.com/watch?v=<id>\""
        },
        {
          "title": "Keep the cache between runs",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" -v yt-dlp-cache:/cache ghcr.io/randomcontainers/yt-dlp \"https://www.youtube.com/watch?v=<id>\""
        }
      ],
