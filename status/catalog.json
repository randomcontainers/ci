    {
      "name": "streamlink",
      "kind": "package",
      "title": "Streamlink",
      "summary": "Extracts live streams from Twitch, YouTube and many other sites and saves them to a file or pipes them into a video player.",
      "homepage": "https://streamlink.github.io/",
      "repository": "https://github.com/randomcontainers/streamlink",
      "license": "BSD-2-Clause AND BSD-3-Clause AND MIT AND Apache-2.0 AND MPL-2.0 AND ISC AND PSF-2.0 AND Unlicense AND Zlib AND LGPL-2.1-only AND LGPL-2.1-or-later",
      "version": "8.6.1",
      "versioning": "semver",
      "examples": [
        {
          "title": "List the qualities a stream is available in",
          "command": "docker run --rm ghcr.io/randomcontainers/streamlink \"https://www.twitch.tv/<channel>\""
        },
        {
          "title": "Record a live stream to a file in the current directory",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/streamlink -o recording.ts \"https://www.twitch.tv/<channel>\" best"
        },
        {
          "title": "Watch a stream in a player on the host",
          "command": "docker run --rm ghcr.io/randomcontainers/streamlink --stdout \"https://www.twitch.tv/<channel>\" best | mpv -"
        }
      ],
