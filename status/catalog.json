    {
      "name": "ghostscript",
      "kind": "package",
      "title": "Ghostscript",
      "summary": "Renders and converts PostScript and PDF files, and merges and compresses PDFs.",
      "homepage": "https://www.ghostscript.com/",
      "repository": "https://github.com/randomcontainers/ghostscript",
      "license": "AGPL-3.0-or-later AND Apache-2.0 AND BSD-3-Clause AND FTL AND ISC AND MIT AND Zlib",
      "version": "10.08.0",
      "versioning": "loose",
      "examples": [
        {
          "title": "Convert a PostScript file to PDF",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ghostscript -sDEVICE=pdfwrite -o output.pdf input.ps"
        },
        {
          "title": "Render every page of a PDF to a 150 dpi PNG",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ghostscript -sDEVICE=png16m -r150 -o page-%03d.png input.pdf"
        },
        {
          "title": "Make a PDF smaller by downsampling its images",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ghostscript -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -o smaller.pdf input.pdf"
        },
        {
          "title": "Merge several PDFs into one",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ghostscript -sDEVICE=pdfwrite -o merged.pdf first.pdf second.pdf"
        }
      ],
