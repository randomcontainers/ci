    {
      "name": "ffmpeg",
      "kind": "package",
      "title": "FFmpeg",
      "summary": "Converts, filters and streams audio and video. Built from the signed FFmpeg release, with x264, x265, VP9, AV1, Opus, MP3 and subtitle rendering.",
      "homepage": "https://ffmpeg.org/",
      "repository": "https://github.com/randomcontainers/ffmpeg",
      "license": "GPL-3.0-or-later",
      "version": "9.0.2",
      "versioning": "semver",
      "examples": [
        {
          "title": "Convert a video to H.264 and AAC in an MP4 file",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ffmpeg -i input.mkv -c:v libx264 -crf 23 -c:a aac output.mp4"
        },
        {
          "title": "Encode a video to AV1 with SVT-AV1 and Opus",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/ffmpeg -i input.mp4 -c:v libsvtav1 -preset 8 -crf 35 -c:a libopus output.webm"
        },
        {
          "title": "Show the streams in a file with ffprobe",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" --entrypoint ffprobe ghcr.io/randomcontainers/ffmpeg -hide_banner input.mp4"
        }
      ],
