          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/imagemagick input.png -quality 80 output.webp"
        },
        {
          "title": "Resize a photo to fit in 1600x1600 and strip its metadata",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/imagemagick photo.heic -resize 1600x1600 -strip photo.jpg"
        },
        {
          "title": "Make a contact sheet of every JPEG in the current directory",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/imagemagick montage -geometry 240x240+4+4 *.jpg contact-sheet.jpg"
        },
        {
          "title": "Render the first page of a PDF at 150 dpi (default image)",
          "command": "docker run --rm --user \"$(id -u):$(id -g)\" -v \"$PWD:/work\" ghcr.io/randomcontainers/imagemagick -density 150 \"input.pdf[0]\" page-1.png"
        }
