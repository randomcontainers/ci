    {
      "name": "imagemagick",
      "kind": "package",
      "title": "ImageMagick",
      "summary": "Converts and edits images, with JPEG, PNG, TIFF, WebP, HEIC, AVIF, JPEG XL, JPEG 2000 and camera raw support.",
