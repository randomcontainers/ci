# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# Generated from randomcontainers/yt-dlp package.yml by randomcontainers/ci. Do not edit.
FROM ffmpeg AS base
FROM yt-dlp AS yt-dlp
FROM base
USER 0:0
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=yt-dlp /usr/local/ /usr/local/
RUN set -eu; \
    for f in /usr/local/share/randomcontainers/*/runtime-deps; do cat "$f"; echo; done > /tmp/runtime-deps; \
    sort -u -o /tmp/runtime-deps /tmp/runtime-deps; \
    if grep -Ev '^([a-z0-9][a-z0-9+.-]*)?$' /tmp/runtime-deps >&2; then echo 'runtime-deps: invalid package name' >&2; exit 1; fi; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends < /tmp/runtime-deps; \
    /usr/local/lib/yt-dlp/bin/pip install --no-cache-dir --disable-pip-version-check --no-input --no-deps --require-hashes --only-binary=:all: --report /tmp/extras-report.json -r /usr/local/share/randomcontainers/yt-dlp/requirements-deno.lock; \
    /usr/local/lib/yt-dlp/bin/python -c "$(printf '%s\n' \
        'import json, pathlib, shutil, sys' \
        'from importlib import metadata' \
        'NAMES = ("LICENSE", "LICENCE", "COPYING", "NOTICE", "AUTHORS")' \
        'report, meta = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])' \
        'installed = json.loads(report.read_text())["install"]' \
        'with open(meta / "source", "a") as source:' \
        '    for item in installed:' \
        '        info = item["download_info"]' \
        '        print(info["url"] + "#sha256=" + info["archive_info"]["hashes"]["sha256"], file=source)' \
        'for item in installed:' \
        '    dist = metadata.distribution(item["metadata"]["name"])' \
        '    name = dist.metadata["Name"]' \
        '    files = [' \
        '        p for p in dist.files or ()' \
        '        if len(p.parts) > 1 and p.parts[0].endswith(".dist-info")' \
        '        and (p.parts[1] == "licenses" or p.name.upper().startswith(NAMES))' \
        '    ]' \
        '    if not files:' \
        '        sys.exit("no license file found for " + name)' \
        '    for path in files:' \
        '        rel = path.parts[2:] if path.parts[1] == "licenses" else path.parts[1:]' \
        '        target = meta.joinpath("licenses", name, *rel)' \
        '        target.parent.mkdir(parents=True, exist_ok=True)' \
        '        shutil.copyfile(path.locate(), target)')" \
        /tmp/extras-report.json /usr/local/share/randomcontainers/yt-dlp; \
    rm -rf /var/lib/apt/lists/* /tmp/runtime-deps /tmp/extras-report.json; \
    ldconfig
ENV DENO_DIR=/cache/deno \
    PYTHONUNBUFFERED=1
USER 1000:1000
ENTRYPOINT ["tini","--","yt-dlp"]
CMD ["--help"]
