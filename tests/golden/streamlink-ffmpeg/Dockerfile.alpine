# Generated from randomcontainers/streamlink package.yml by randomcontainers/ci. Do not edit.
FROM ffmpeg AS base
FROM streamlink AS streamlink
FROM base
USER 0:0
COPY --link --from=streamlink /usr/local/ /usr/local/
RUN set -eu; \
    for f in /usr/local/share/randomcontainers/*/runtime-deps; do cat "$f"; echo; done > /tmp/runtime-deps; \
    sort -u -o /tmp/runtime-deps /tmp/runtime-deps; \
    if grep -Ev '^((so:)?[A-Za-z0-9][A-Za-z0-9+._-]*)?$' /tmp/runtime-deps >&2; then echo 'runtime-deps: invalid package name' >&2; exit 1; fi; \
    xargs apk add --no-cache < /tmp/runtime-deps; \
    rm -f /tmp/runtime-deps
ENV PYTHONUNBUFFERED=1
USER 1000:1000
ENTRYPOINT ["tini","--","streamlink"]
CMD ["--help"]
